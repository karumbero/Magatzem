<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso para que la app «Migracion» (firmada con la misma clave) lea el catálogo de Magatzem; solo lectura. -->
    <permission
        android:name="com.example.magatzem.permission.LEER_PARA_MIGRAR"
        android:protectionLevel="signature" />

    <!-- Sincronizar con el TPV por la red de la tienda (o Tailscale). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MagatzemApplication"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Magatzem">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Magatzem"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Aparece en "Compartir" de MiTPV (cierre de caja): se importa directamente, sin pasar por ficheros. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/json" />
            </intent-filter>
            <!-- Escaneo manda una factura leída (PDF o foto) para revisarla y darle entrada. -->
            <intent-filter>
                <action android:name="com.example.magatzem.action.IMPORTAR_ESCANEO" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- "Abrir con" un archivo .json (p. ej. recibido por Quick Share o correo y guardado en Descargas): pasa a pendientes. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <provider
            android:name=".MigracionProvider"
            android:authorities="com.example.magatzem.migracion"
            android:exported="true"
            android:readPermission="com.example.magatzem.permission.LEER_PARA_MIGRAR" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>